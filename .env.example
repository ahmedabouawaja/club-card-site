# Copy this file to .env and fill in real values. Never commit the real .env file.

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-value
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"

# Database (SQLite by default; swap for Postgres/MySQL in production)
DATABASE_URL=sqlite:///club.db

# Session / cookies
SESSION_COOKIE_SECURE=true

# Admin bootstrap (used once, by flask create-admin command)
ADMIN_EMAIL=admin@example.com

# Rate limiting storage (use redis:// in production instead of memory://)
RATELIMIT_STORAGE_URI=memory://
